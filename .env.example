# Node 22.16+ or 24. Use a long-lived single instance and a mounted persistent disk.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
QUEUE_DB_PATH=/var/lib/cams/attendance.sqlite

# Shared device token mode. Prefer a per-device registry for multiple devices.
CAMS_AUTH_TOKEN=replace_with_portal_token
# CAMS_DEVICES_JSON='[{"serialNumber":"SERIAL-1","authToken":"device-token","targets":["bgc","sempl"]}]'
# In registry mode only listed devices authenticate; CAMS_AUTH_TOKEN is unused.
CAMS_ALLOW_LEGACY_FLAT=false
# If the CAMS portal has payload encryption enabled, supply its 32 UTF-8 key bytes as hex.
# CAMS_ENCRYPTION_KEY_HEX=

# Intentionally no invented ERP endpoint URLs. Obtain and verify each receiving contract.
BGC_SIXORBIT_URL=
# Match the actual endpoint contract: bearer (original integration) or api-key-hmac (SO external API).
BGC_SIXORBIT_AUTH_MODE=bearer
BGC_SIXORBIT_TOKEN=
# BGC_SIXORBIT_API_KEY=  # required instead of TOKEN when AUTH_MODE=api-key-hmac
BGC_SIXORBIT_COMPANY=BGC
BGC_SIXORBIT_TIME_ZONE=Asia/Kolkata
# cams-json = an existing receiver accepting sanitised CAMS envelopes;
# mapped-json = a receiver expecting configured flat fields.
BGC_SIXORBIT_MODE=mapped-json
# Illustrative mapping only: replace field names to match the verified Sixorbit contract.
BGC_SIXORBIT_FIELD_MAP_JSON='{"employee_id":"employeeId","timestamp":"timestamp","type":"punchType","event_id":"eventId"}'
# Required for cams-json/mapped-json. These examples expect {"success":true}; verify your receiver.
BGC_SIXORBIT_SUCCESS_PATH=success
BGC_SIXORBIT_SUCCESS_VALUE=true
# Optional explicit device:user -> receiver employee/attendance ID mapping.
# BGC_SIXORBIT_EMPLOYEE_MAP_JSON='{"SERIAL-1:123":"BGC-123"}'

SEMPL_ERPNEXT_URL=
SEMPL_ERPNEXT_API_KEY=
SEMPL_ERPNEXT_API_SECRET=
SEMPL_ERPNEXT_COMPANY=SEMPL
SEMPL_ERPNEXT_TIME_ZONE=Asia/Kolkata
# frappe-checkin = Frappe HR native Employee Checkin method; cams-json/mapped-json also supported.
SEMPL_ERPNEXT_MODE=frappe-checkin
# SEMPL_ERPNEXT_EMPLOYEE_MAP_JSON='{"SERIAL-1:123":"SEMPL-device-id-123"}'
# Native Frappe defaults to CheckIn/CheckOut only. Explicitly approve break/meal/overtime semantics.
SEMPL_ERPNEXT_PUNCH_TYPE_MAP_JSON='{"CheckIn":"IN","CheckOut":"OUT"}'
# For SEMPL cams-json/mapped-json modes also set SUCCESS_PATH, SUCCESS_VALUE and (if mapped) FIELD_MAP_JSON.

DELIVERY_TIMEOUT_MS=10000
DELIVERY_MAX_ATTEMPTS=8
RETRY_BASE_MS=1000
QUEUE_POLL_MS=100
MAX_PENDING_DELIVERIES=100000
MAX_PAYLOAD_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=15000
